# Copy to secrets.yaml (same folder as lastdrop.yaml in ESPHome) and fill in your own values.
# Make the key with: openssl rand -base64 32   (or let the ESPHome dashboard make one)
wifi_ssid: "your-wifi-name"
wifi_password: "your-wifi-password"
lastdrop_api_key: "paste-a-32-byte-base64-key-here"
lastdrop_ota_password: "pick-a-long-random-password"
